<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="afs_terminal_view_list" model="ir.ui.view">
        <field name="name">afs.terminal.list</field>
        <field name="model">afs.terminal</field>
        <field name="arch" type="xml">
            <list string="AFS Terminals">
                <field name="name"/>
                <field name="mid"/>
                <field name="tid"/>
                <field name="journal_id"/>
                <field name="currency_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="afs_terminal_view_form" model="ir.ui.view">
        <field name="name">afs.terminal.form</field>
        <field name="model">afs.terminal</field>
        <field name="arch" type="xml">
            <form string="AFS Terminal">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                    <button name="action_run_settlement" type="object" string="Run Settlement" class="btn-secondary"
                            confirm="This will run Settlement on the physical terminal now. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Reception — Dubai"/></h1>
                    </div>
                    <group>
                        <group string="Credentials">
                            <field name="mid"/>
                            <field name="tid"/>
                            <field name="tenant"/>
                            <field name="secure_key_param"/>
                            <field name="endpoint_url"/>
                            <field name="integrator_name"/>
                        </group>
                        <group string="Accounting">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="journal_id"/>
                            <field name="max_amount"/>
                        </group>
                    </group>
                    <group>
                        <group string="Receipt / Teller Defaults">
                            <field name="teller_full_name"/>
                            <field name="teller_user_name"/>
                            <field name="printer_width"/>
                            <field name="print_pos_receipt"/>
                            <field name="print_receipt_note"/>
                        </group>
                        <group string="Behaviour">
                            <field name="timeout"/>
                            <field name="void_requires_open_batch"/>
                            <field name="last_settlement_batch_number" readonly="1"/>
                            <field name="last_settlement_date" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Access">
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="afs_terminal_action" model="ir.actions.act_window">
        <field name="name">AFS Terminals</field>
        <field name="res_model">afs.terminal</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
